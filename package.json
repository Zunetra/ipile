{
  "name": "ipile",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Machine bootstrap and git completion. Toolchains, git identities, hooks and global config, one skippable step at a time.",
  "keywords": [
    "bootstrap",
    "dotfiles",
    "developer-setup",
    "git",
    "ssh",
    "multiple-git-accounts",
    "commit-signing",
    "git-hooks",
    "shell",
    "bash",
    "cli"
  ],
  "author": "Olorunshogo Moses BAMTEFA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zunetra/ipile.git"
  },
  "bugs": {
    "url": "https://github.com/Zunetra/ipile/issues"
  },
  "homepage": "https://github.com/Zunetra/ipile#readme",
  "os": [
    "linux",
    "darwin"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.16.1",
  "directories": {
    "bin": "bin",
    "lib": "lib",
    "doc": "docs"
  },
  "bin": {
    "ipile": "./bin/ipile"
  },
  "scripts": {
    "prepare": "husky",
    "start": "./bin/ipile",
    "help": "./bin/ipile help",
    "usage": "./bin/ipile help",
    "status": "./bin/ipile status",
    "doctor": "./bin/ipile doctor",
    "dry": "./bin/ipile run --dry-run",
    "dry:yes": "./bin/ipile run --dry-run --yes",
    "demo": "mkdir -p /tmp/ipile-demo && HOME=/tmp/ipile-demo ./bin/ipile",
    "demo:accounts": "mkdir -p /tmp/ipile-demo && HOME=/tmp/ipile-demo ./bin/ipile git-accounts",
    "demo:doctor": "HOME=/tmp/ipile-demo ./bin/ipile doctor",
    "demo:tree": "find /tmp/ipile-demo -maxdepth 2 2>/dev/null || echo 'no sandbox yet, run: pnpm demo'",
    "demo:clean": "rm -rf /tmp/ipile-demo",
    "check": "bash -n bin/ipile lib/*.sh lib/core/*.sh lib/modules/*.sh lib/assets/shell/*.sh lib/assets/bin/* lib/assets/hooks/pre-commit lib/assets/hooks/pre-push",
    "lint": "scripts/shellcheck.sh",
    "lint:install": "scripts/shellcheck.sh --install",
    "format": "scripts/shfmt.sh && prettier --write .",
    "format:check": "scripts/shfmt.sh --check && prettier --check .",
    "format:install": "scripts/shfmt.sh --install",
    "build": "bash build-and-install.sh",
    "symlink": "scripts/symlink-check.sh",
    "test": "pnpm run check && pnpm run lint && pnpm run symlink"
  },
  "validate-branch-name": {
    "pattern": "^(main|develop|live)$|^(feature|fix|refactor|hotfix|release|conflict|chore)/.*$",
    "errorMsg": "Branch name structure: <type>/<description>\nAllowed prefixes: feature, fix, refactor, hotfix, release, conflict, chore"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "validate-branch-name": "1.3.2"
  }
}
