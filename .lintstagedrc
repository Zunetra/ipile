{
  "bin/ipile": ["bash -n", "scripts/shfmt.sh", "scripts/shellcheck-files.sh"],
  "*.sh": ["bash -n", "scripts/shfmt.sh", "scripts/shellcheck-files.sh"],
  "lib/assets/hooks/*": [
    "bash -n",
    "scripts/shfmt.sh",
    "scripts/shellcheck-files.sh"
  ],
  ".husky/pre-*": [
    "bash -n",
    "scripts/shfmt.sh",
    "scripts/shellcheck-files.sh"
  ],
  "*.{json,md,yml,yaml}": ["prettier --write"]
}
